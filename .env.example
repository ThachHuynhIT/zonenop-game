# Copy this file to .env and fill in real values. Never commit .env.

# Public site origin. Read by src/app/layout.tsx (metadataBase). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# be_game backend (rooms over HTTP + WebSocket), see the be_game repo. No trailing slash.
# NEXT_PUBLIC_* values are inlined at build time: on Docker they are passed as build args
# (compose.selfhost.yml), so changing them needs a rebuild, not just a restart.
NEXT_PUBLIC_TIENLEN_SERVER_URL="http://localhost:4000"

# Optional backup be_game backend, used for lobbies and new rooms while the main one does not answer
# (e.g. https://be-game-omega.vercel.app as backup for the self-hosted https://game.fudio101.com).
# Each backend has its own rooms and leaderboard; a room always reconnects to the backend it was
# created on. Inlined at build time, like the variable above.
NEXT_PUBLIC_TIENLEN_FALLBACK_URL=""

# Self-host only (compose.selfhost.yml): public hostname Traefik routes to this app.
# be_game's ALLOWED_ORIGIN must include https://<WEB_DOMAIN> or its WebSockets reject the page.
WEB_DOMAIN="games.example.com"

# Dev tooling only — used by a local Context7 MCP server (up-to-date library docs).
# Optional: without it Context7 still works at a lower anonymous rate limit. Never read by app code.
CONTEXT7_API_KEY=""
